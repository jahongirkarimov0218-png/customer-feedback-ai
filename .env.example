# ==============================================================================
# Customer Feedback AI Intelligence - Environment Variables Configuration
# ==============================================================================
#
# QAYD / NOTE:
# Ushbu loyiha "Zero-Config Fallback Semantic Engine" bilan jihozlangan.
# Agar birorta ham API kalit kiritilmasa yoki tashqi provayder kvotasi tugasa,
# tizim ichki aqlli semantik tahlil algoritmlari orqali 100% oflayn rejimda
# xatosiz ishlayveradi (oq ekran yoki 500 error bo'lmaydi).
#
# XAVFSIZLIK / SECURITY:
# Barcha API kalitlar faqat server tomonida (Next.js Route Handlers) qo'llaniladi.
# Hech qachon NEXT_PUBLIC_ prefiksi bilan AI kalitlarini saqlamang.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Tavsiya etiladi / Recommended)
# Olish uchun: https://aistudio.google.com/app/apikey
# Model: gemini-1.5-flash / gemini-1.5-pro
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 2. OpenAI API (Ixtiyoriy / Optional)
# Olish uchun: https://platform.openai.com/api-keys
# Model: gpt-4o-mini
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"

# ------------------------------------------------------------------------------
# 3. Groq Cloud API (Ixtiyoriy / Optional - Llama 3 / Mixtral)
# Olish uchun: https://console.groq.com/keys
# Model: llama-3.1-70b-versatile
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk_YourGroqApiKeyHere"
